<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- WidgetKit requires the sandbox. The one exception lets the widgets read the snapshots
     Termorc writes (WidgetStore.dir); everything else they need goes through Termorc. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
  <array>
    <string>/Library/Application Support/Termorc/widgets/</string>
  </array>
</dict>
</plist>
