{
  "name": "termac",
  "version": "1.0.0",
  "description": "Arc browser-inspired terminal for macOS",
  "main": "electron/main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "concurrently \"vite\" \"sleep 2 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "build": "vite build && electron-builder",
    "preview": "vite build && env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-store": "^8.2.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.termac.app",
    "productName": "Termac",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "node-pty@1.1.0": true,
    "esbuild@0.25.12": true
  }
}
