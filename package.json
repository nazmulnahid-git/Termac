{
  "name": "termorc",
  "version": "2.0.1",
  "description": "A terminal for macOS where sessions live in a sidebar, grouped into Spaces",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build",
    "start": "tauri build --debug --bundles app && open src-tauri/target.noindex/debug/bundle/macos/Termorc.app",
    "test": "node --test \"tests/**/*.test.js\"",
    "dist": "tauri build --bundles app && scripts/make-dmg.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
